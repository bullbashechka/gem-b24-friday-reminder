# Входящий вебхук Битрикс24 (СЕКРЕТ — не коммитить .env)
# Формат: https://portal.bitrix24.ru/rest/USER_ID/WEBHOOK_CODE/
WEBHOOK_URL=

# Таймзона портала (IANA), по ней считаются границы "сегодня"
TIMEZONE=Asia/Almaty

# Путь к лог-файлу (используется как справочная информация; запись делает cron через >>)
LOG_PATH=/opt/b24-friday-reminder/logs/app.log

# Тест-режим: 1 — логировать адресатов, но НЕ отправлять сообщения
DRY_RUN=

# Тест-режим: если задан, ВСЕ сообщения уходят только на этот user ID (себе)
TEST_USER_ID=
